# ─── Supabase ─────────────────────────────────────────────────────────────────
# Proyecto: https://supabase.com/dashboard/project/<ID>/settings/api
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Backend Railway ──────────────────────────────────────────────────────────
# URL pública de tu servicio en Railway (sin barra final)
VITE_API_URL=https://ferzu-backend-production.up.railway.app/api

# ─── Bold Pagos (Colombia) ────────────────────────────────────────────────────
# Dashboard: https://dashboard.bold.co/developers
VITE_BOLD_API_KEY=pk_prod_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_BOLD_REDIRECT_URL=https://ferzu-pos.vercel.app/pricing?payment=success

# ─── Datos de contacto ────────────────────────────────────────────────────────
VITE_NEQUI_NUMBER=300 000 0000
VITE_SUPPORT_PHONE=+57 300 000 0000
