# ======================================================
# FERZU POS BACKEND — Variables de Entorno
# Copia este archivo como .env y llena los valores reales
# ======================================================

# Supabase (Settings > API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...TU_SERVICE_ROLE_KEY

# API key de Anthropic para IA
# Genera una en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-TU_CLAVE_AQUI

# Puerto del servidor (Railway lo sobreescribe automáticamente)
PORT=3001

# URL del frontend (para CORS)
# Local: http://localhost:5177
# Producción: https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5177

# Entorno
NODE_ENV=development
