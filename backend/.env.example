# =============================================================================
# FERZU POS — Backend Variables de Entorno (Railway)
# En Railway: Settings → Variables → Raw Editor
# =============================================================================

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Supabase (service_role — NUNCA exponer al frontend) ──────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Múltiples orígenes separados por coma
FRONTEND_URL=https://ferzu-pos.vercel.app

# ─── Anthropic IA ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Bold Pagos ───────────────────────────────────────────────────────────────
BOLD_SECRET_KEY=sk_prod_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend (emails) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@ferzu.co

# ─── Alertas externas (monitoreo proactivo cada 5 min) ───────────────────────
# Email de destino para alertas de sistema
ALERT_EMAIL=tu@email.com

# WhatsApp via Callmebot (gratis):
#   1. Envía WhatsApp a +34 644 59 77 71 con: "I allow callmebot to send me messages"
#   2. Recibirás tu APIKEY por WhatsApp
ALERT_WHATSAPP_PHONE=573001234567
ALERT_WHATSAPP_APIKEY=xxxxxxxx
